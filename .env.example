# Copy to .env and fill in. Never commit .env.

# team id from hackathon.certivity.io; written into exported files
CERTIVITY_TEAM_ID=
# Model credential (ANTHROPIC_AUTH_TOKEN also works)
ANTHROPIC_API_KEY=

# Optional
# CERTIVITY_PARTICIPANT_PACKAGE=data/participant-package
# CERTIVITY_CACHE_DIR=data/cache          # parsed paragraphs, rendered pages, cached model answers
# CERTIVITY_RUNS_DIR=runs
# CERTIVITY_NOTES=src/certivity/notes.md     # corpus-specific guidance for the prompts
# CERTIVITY_STYLE=src/certivity/style.md     # house style for wording and selecting requirements
# CERTIVITY_MODEL_SELECT=claude-sonnet-5-5   # two calls: applicable regulations, then sections in scope
# CERTIVITY_MODEL_FILTER=claude-haiku-5-5    # batched calls: screen paragraphs, then write requirements
# CERTIVITY_SCREEN_BATCH=60                  # paragraphs per screening call (returns ids only)
# CERTIVITY_SCREEN_PASSES=2                 # screening passes with shifted batches; their union goes on (recall)
# CERTIVITY_MODEL_WRITE=claude-haiku-5-5     # Sonnet tested worse here: more requirements, lower precision, ~$0.60 more
# CERTIVITY_WRITE_PASSES=3                  # writing passes; a paragraph kept by CERTIVITY_WRITE_VOTES of them stays
# CERTIVITY_MODEL_ARBITER=claude-sonnet-5-5 # settles paragraphs the writing passes disagree on; empty = off
# CERTIVITY_MODEL_GAPFILL=claude-sonnet-5-5 # adds obligations a cited paragraph states but the list misses; empty = off
# CERTIVITY_WRITE_VOTES=1                   # only without an arbiter: 1 = union (most recall), 3 = all agree
# CERTIVITY_WRITE_BATCH=15                   # paragraphs per writing call
# CERTIVITY_WRITE_EFFORT=medium              # thinking for the writing pass: splitting lists and tables needs it
# CERTIVITY_PARALLEL=8                       # filter calls in flight
