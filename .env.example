# Copy to .env and fill in. Never commit .env.

# Where the official participant package is checked out (git clone of Certivity/industrial-ai-hackathon).
CERTIVITY_PARTICIPANT_PACKAGE=data/participant-package
# Generated corpus snapshots (corpus module) and run artifacts (app).
CERTIVITY_CORPUS_DIR=data/cache/corpus   # CERTIVITY_CORPUS_CACHE (corpus module's name) also works
CERTIVITY_RUNS_DIR=runs

# team id from hackathon.certivity.io; written into exported files only
CERTIVITY_TEAM_ID=

# "real" uses the agent/corpus/quality modules; "fixture" uses labelled synthetic stand-ins.
CERTIVITY_PIPELINE_MODE=real
CERTIVITY_MAX_REVISION_ROUNDS=2
CERTIVITY_RUN_TIME_BUDGET_S=10800
# Cap on paid model calls per run (extraction + review). Unset: contracts default (400).
# CERTIVITY_MAX_MODEL_CALLS=40
# Review's own call budget (separate adapter). Unset: same as the extraction budget.
# CERTIVITY_MAX_REVIEW_CALLS=40

# Model provider (docs/agent/dependencies.md, Anushree). Required for a real analysis.
# ANTHROPIC_AUTH_TOKEN or an `ant auth login` profile also work instead of the key.
ANTHROPIC_API_KEY=
# CERTIVITY_MODEL=claude-opus-5
# CERTIVITY_MODEL_EFFORT=high
# CERTIVITY_MAX_OUTPUT_TOKENS=16000
# ANTHROPIC_BASE_URL=
# "auto" (default): the model while it can be used, no-model economy mode once it cannot (e.g. no credit).
# "economy": never call the model - seconds per run, $0. "model": always the model; fail if unusable.
# "lite": AI interpretation on Claude Haiku 5.5 (~$1-2 a run, minutes), economy fallback without credit.
# CERTIVITY_EXTRACTION_MODE=auto
# Per-stage model. Extraction is ~90% of the calls, so this is the main cost and speed lever.
# CERTIVITY_MODEL_EXTRACT=claude-sonnet-5-5
# Part-category recognition and section triage (default: claude-haiku-5-5 at low effort).
# CERTIVITY_MODEL_TRIAGE=claude-haiku-5-5
# CERTIVITY_EFFORT_TRIAGE=low
# Sections extracted concurrently (default 8). Bounded by the account's rate limit.
# CERTIVITY_MAX_PARALLEL_SECTIONS=16
# Part categories and what runs learned about them; "off" relearns on every run.
# CERTIVITY_CATEGORY_REGISTRY=data/cache/part_categories.json
# Non-secret model settings are part of the cache key; anything containing KEY/SECRET/TOKEN/PASSWORD is never shown or hashed.

# Optional overrides if a module's entry point differs from the planned location ("module:attribute").
# CERTIVITY_EP_OPEN_CORPUS=certivity.corpus:open_corpus
# CERTIVITY_EP_BOOTSTRAP_CORPUS=certivity.corpus:bootstrap
# CERTIVITY_EP_CREATE_LLM=certivity.llm:create_llm
# CERTIVITY_EP_RUN_EXTRACTION=certivity.agent:run_extraction
# CERTIVITY_EP_REVISE_EXTRACTION=certivity.agent:revise_extraction
# CERTIVITY_EP_REVIEW_REQUIREMENTS=certivity.quality:review_requirements
# CERTIVITY_EP_BUILD_SUBMISSION=certivity.quality:build_submission
# CERTIVITY_EP_VALIDATE_SUBMISSION=certivity.quality:validate_submission
# CERTIVITY_EP_EVALUATE_CASE=certivity.evaluation:evaluate_case
# CERTIVITY_EP_MAKE_RUN_INPUT=certivity.contracts:make_run_input
